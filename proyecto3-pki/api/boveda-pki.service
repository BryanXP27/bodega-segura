[Unit]
Description=Boveda Segura mTLS API (Proyecto 3 UNDC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/boveda-pki/api
Environment=PORT=8443
ExecStart=/usr/bin/python3 /opt/boveda-pki/api/server.py
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
