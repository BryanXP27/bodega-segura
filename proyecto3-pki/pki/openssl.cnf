# ==============================================================================
# OpenSSL Configuration for Mini-PKI (Proyecto 3 - UNDC 2026)
# ==============================================================================

[ default ]
name                    = mini-pki
default_ca              = ca_default

[ ca_default ]
dir                     = .
certs                   = $dir/certs
new_certs_dir           = $dir/certs/issued
database                = $dir/index.txt
serial                  = $dir/serial
crlnumber               = $dir/crlnumber
default_crl_days        = 365
RANDFILE                = $dir/.rand

certificate             = $dir/certs/ca.crt
private_key             = $dir/certs/private/ca.key

default_md              = sha256
default_days            = 365
preserve                = no
policy                  = policy_loose

[ policy_loose ]
countryName             = optional
stateOrProvinceName     = optional
localityName            = optional
organizationName        = optional
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[ req ]
default_bits            = 2048
default_md              = sha256
string_mask             = utf8only
distinguished_name      = req_distinguished_name
attributes              = req_attributes

[ req_distinguished_name ]
countryName                     = Pais (2 letras, ej. PE)
countryName_default             = PE
stateOrProvinceName             = Region / Provincia
stateOrProvinceName_default     = Lima
localityName                    = Ciudad / Distrito
localityName_default            = Canete
organizationName                = Organizacion / Universidad
organizationName_default        = UNDC - Seguridad Informatica
organizationalUnitName          = Unidad
organizationalUnitName_default  = Proyecto 3 Mini-PKI
commonName                      = Nombre Comun (CN - FQDN o Usuario)
commonName_default              = Boveda Mini-PKI Root CA
emailAddress                    = Correo Electronico
emailAddress_default            = pki@undc.edu.pe

[ req_attributes ]

# Extensiones para la Autoridad Certificadora (Root CA)
[ v3_ca ]
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always,issuer
basicConstraints        = critical, CA:true
keyUsage                = critical, digitalSignature, cRLSign, keyCertSign

# Extensiones para el Certificado de Cliente (mTLS)
[ client_cert ]
basicConstraints        = CA:FALSE
nsCertType              = client, email
nsComment               = "Certificado de Cliente mTLS - Proyecto 3"
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid,issuer
keyUsage                = critical, nonRepudiation, digitalSignature, keyEncipherment
extendedKeyUsage        = clientAuth, emailProtection

# Extensiones para el Certificado del Servidor (API)
[ server_cert ]
basicConstraints        = CA:FALSE
nsCertType              = server
nsComment               = "Certificado de Servidor API - Proyecto 3"
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid,issuer:always
keyUsage                = critical, digitalSignature, keyEncipherment
extendedKeyUsage        = serverAuth
subjectAltName          = @alt_names

[ alt_names ]
DNS.1                   = localhost
DNS.2                   = 127.0.0.1
IP.1                    = 127.0.0.1
IP.2                    = 0.0.0.0

